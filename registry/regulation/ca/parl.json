    {
      "patterns": [
        "^bill-c-34$",
        "^safe-social-media-act$",
        "^digital-safety-act$"
      ],
      "description": "Bill C-34 — Safe Social Media Act (Digital Safety Act)",
      "weight": 100,
      "data": {
        "official_name": "An Act to enact the Digital Safety Act and the Digital Safety Commission of Canada Act and to make consequential and related amendments to other Acts",
        "common_name": "Safe Social Media Act (Bill C-34)",
        "alternate_names": [
          "Digital Safety Act",
          "Digital Safety Commission of Canada Act",
          "Bill C-34 (45th Parliament, 1st Session)"
        ],
        "description": "Proposed Canadian federal legislation regulating social media platforms and AI chatbot services accessible to Canadians, with a statutory Duty to Act Responsibly toward child users and mandatory safeguards against manipulative AI companion design.",
        "notes": "Status: Proposed — At consideration in committee in the House of Commons; passed second reading on October 29, 2026 (agreed to on division) and referred to the Standing Committee on Canadian Heritage (CHPC); first reading June 10, 2026 (45th Parliament, 1st Session; verified as of 2026-11-04). Note: Bill numbers reset each parliamentary session; in the 44th Parliament, 1st Session, Bill C-34 was the National Security Review of Investments Modernization Act (S.C. 2024, c. 4, amending the Investment Canada Act). Explicitly brings interactive AI chatbot services within the scope of the Digital Safety Act: prohibits bots from deceptively claiming to be human or impersonating licensed medical/mental health professionals, bars design features intended to induce emotional dependency or harm in minors, requires risk assessments and mitigation plans, and establishes the Digital Safety Commission of Canada.",
        "urls": [
          {
            "type": "website",
            "url": "https://www.parl.ca/legisinfo/en/bill/45-1/c-34"
          },
          {
            "type": "api",
            "url": "https://www.parl.ca/legisinfo/en/bill/45-1/c-34/json",
            "note": "LEGISinfo machine-readable bill status JSON"
          }
        ],
        "examples": [
          "bill-c-34",
          "safe-social-media-act"
        ]
      }
    },
