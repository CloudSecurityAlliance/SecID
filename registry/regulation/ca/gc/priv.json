    {
      "patterns": [
        "(?i)^ppcda-bill-c36$"
      ],
      "description": "Protecting Privacy and Consumer Data Act (Bill C-36) — proposed PIPEDA successor",
      "weight": 90,
      "data": {
        "official_name": "Protecting Privacy and Consumer Data Act",
        "common_name": "PPCDA / Bill C-36",
        "alternate_names": [
          "Bill C-36"
        ],
        "description": "Third federal attempt at private-sector privacy reform (after the CPPA in the prior Bill C-27, which died on the order paper January 2025). First reading June 15, 2026. Would replace PIPEDA, introduce a new enforcement body (the Digital Safety and Data Protection Commission of Canada), and penalties up to CAD 25M or 5% of global revenue.",
        "notes": "Status: Proposed — At second reading in the House of Commons; First reading completed June 15, 2026 in the 45th Parliament, 1st Session (verified as of 2026-11-04). Not yet in force — track alongside PIPEDA (secid:regulation/priv.gc.ca/pipeda) which remains current law.",
        "urls": [
          {
            "type": "website",
            "url": "https://www.parl.ca/legisinfo/en/bill/45-1/c-36"
          },
          {
            "type": "api",
            "url": "https://www.parl.ca/legisinfo/en/bill/45-1/c-36/json",
            "format": "json",
            "note": "LEGISinfo machine-readable bill status JSON"
          }
        ],
        "examples": []
      },
