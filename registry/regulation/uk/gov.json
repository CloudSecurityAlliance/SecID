    {
      "patterns": [
        "(?i)^osa$",
        "(?i)^online-safety-act$"
      ],
      "description": "Online Safety Act 2023",
      "weight": 100,
      "data": {
        "official_name": "Online Safety Act 2023",
        "common_name": "OSA",
        "alternate_names": [
          "2023 c. 50"
        ],
        "description": "UK law imposing duties of care on online platforms regarding illegal content and content harmful to children. Enforced by Ofcom.",
        "notes": "Status: In force (Royal Assent October 26, 2023; phased commencement through 2025-2026; verified as of 2026-11-04). Amended in April 2026 to explicitly regulate AI chatbots: Section 216A (inserted by the Crime and Policing Act 2026, s. 248) empowers the Secretary of State to bring standalone AI chatbot providers and AI content-generation tools within OSA scope, and Section 214A (inserted by the Children's Wellbeing and Schools Act 2026, s. 70) empowers regulations restricting or preventing children's access to high-risk interactive or AI features.",
        "urls": [
          {
            "type": "legal_text",
            "url": "https://www.legislation.gov.uk/ukpga/2023/50/contents"
          },
          {
            "type": "bulk_data",
            "url": "https://raw.githubusercontent.com/CloudSecurityAlliance-DataSets/dataset-public-laws-regulations-standards/main/regulation/gov.uk/osa/osa-sections.json",
            "format": "json",
            "content_type": "application/json",
            "note": "Extracted section-level JSON in dataset-public-laws-regulations-standards"
          },
          {
            "type": "bulk_data",
            "url": "https://raw.githubusercontent.com/CloudSecurityAlliance-DataSets/dataset-public-laws-regulations-standards/main/regulation/gov.uk/osa/osa.md",
            "format": "markdown",
            "content_type": "text/markdown",
            "note": "Extracted full-text Markdown in dataset-public-laws-regulations-standards"
          }
        ],
        "examples": [
          "s-1",
          "s-214A",
          "s-216A"
        ]
      },
      "children": [
        {
          "patterns": [
            "^s-\\d+[A-Z]?$"
          ],
          "description": "Online Safety Act 2023 section reference (e.g., s-1, s-214A, s-216A)",
          "weight": 100,
          "data": {
            "url": "https://www.legislation.gov.uk/ukpga/2023/50/section/{num}",
            "variables": {
              "num": {
                "extract": "^s-(\\d+[A-Z]?)$",
                "description": "Section number (with optional uppercase letter suffix for inserted sections)"
              }
            },
            "examples": [
              {
                "input": "s-1",
                "variables": {
                  "num": "1"
                },
                "url": "https://www.legislation.gov.uk/ukpga/2023/50/section/1",
                "note": "Introduction and overview of the Online Safety Act 2023"
              }
            ]
          }
        }
      ]
    },
    {
      "patterns": [
        "^crime-and-policing-act-2026$",
