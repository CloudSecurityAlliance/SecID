      "children": [
        {
          "patterns": [
            "^CWE-\\d+$"
          ],
          "description": "CWE identifier (e.g., CWE-79, CWE-1427). Covers views, categories/groupings, and weaknesses — all use the same ID format.",
          "weight": 100,
          "data": {
            "url": "https://cwe.mitre.org/data/definitions/{num}.html",
            "content_type": "text/html",
            "parsability": "scraped",
            "auth": "none",
            "variables": {
              "num": {
                "extract": "^CWE-(\\d+)$",
                "description": "Numeric CWE ID (e.g., '79' from 'CWE-79')"
              }
            },
            "examples": [
              {
                "input": "CWE-79",
                "variables": {
                  "num": "79"
                },
                "url": "https://cwe.mitre.org/data/definitions/79.html"
              },
              {
                "input": "CWE-1427",
                "variables": {
                  "num": "1427"
                },
                "url": "https://cwe.mitre.org/data/definitions/1427.html",
                "note": "Improper Neutralization of Input for LLM Prompting — AI/ML weakness (CWE-1400 series)"
              }
            ]
          }
        },
        {
          "patterns": [
            "^CWE-\\d+$"
          ],
          "description": "CWE JSON via REST API (weakness endpoint)",
          "weight": 50,
          "data": {
            "url": "https://cwe-api.mitre.org/api/v1/cwe/weakness/{num}",
            "format": "json",
            "content_type": "application/json",
            "parsability": "structured",
            "schema": "secid:reference/mitre.org/cwe-schema@8.0",
            "auth": "none",
            "note": "Official MITRE CWE REST API endpoint returning the full CWE weakness record in JSON (HTTP GET). For category/grouping or view IDs, use /api/v1/cwe/category/{num} or /api/v1/cwe/view/{num}.",
            "variables": {
              "num": {
                "extract": "^CWE-(\\d+)$",
                "description": "Numeric CWE ID (e.g., '79' from 'CWE-79')"
              }
            },
            "examples": [
              {
                "input": "CWE-79",
                "variables": {
                  "num": "79"
                },
                "url": "https://cwe-api.mitre.org/api/v1/cwe/weakness/79"
              },
              {
                "input": "CWE-1427",
                "variables": {
                  "num": "1427"
                },
                "url": "https://cwe-api.mitre.org/api/v1/cwe/weakness/1427",
                "note": "Improper Neutralization of Input for LLM Prompting — CWE REST API JSON record"
              }
            ]
          }
        },
        {
          "patterns": [
            "^CWE-\\d+$"
          ],
          "description": "CWE JSON via REST API (entry type lookup across weaknesses, categories/groupings, and views)",
          "weight": 40,
          "data": {
            "url": "https://cwe-api.mitre.org/api/v1/cwe/{num}",
            "format": "json",
            "content_type": "application/json",
            "parsability": "structured",
            "auth": "none",
            "note": "Official MITRE CWE REST API endpoint returning the entry type (e.g., base_weakness, class_weakness, variant_weakness, category, view) for any CWE ID before fetching /cwe/weakness/{num}, /cwe/category/{num}, or /cwe/view/{num}.",
            "variables": {
              "num": {
                "extract": "^CWE-(\\d+)$",
                "description": "Numeric CWE ID (e.g., '79' from 'CWE-79')"
              }
            },
            "examples": [
              {
                "input": "CWE-79",
                "variables": {
                  "num": "79"
                },
                "url": "https://cwe-api.mitre.org/api/v1/cwe/79"
              },
              {
