      "patterns": [
        "^eo-\\d{5}$"
      ],
      "description": "Executive Order",
      "weight": 100,
      "data": {
        "official_name": "Executive Order",
        "common_name": "EO",
        "alternate_names": null,
        "description": "US Presidential Executive Orders identified by sequential number.",
        "notes": "Executive Orders have the force of law but can be revoked by subsequent administrations. URLs vary by administration — no stable URL template exists across administrations.",
        "urls": [
          {
            "type": "website",
            "url": "https://www.whitehouse.gov/briefing-room/"
          }
        ],
        "examples": [
          {
            "input": "eo-14110",
            "note": "Executive Order on Safe, Secure, and Trustworthy AI (Oct 2023)"
          },
          {
            "input": "eo-14028",
            "note": "Executive Order on Improving the Nation's Cybersecurity (May 2021)"
          }
        ]
      }
    },
